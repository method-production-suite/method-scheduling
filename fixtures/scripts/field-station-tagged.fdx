<FinalDraft DocumentType="Script" Template="No" Version="5">
<!-- An invented three-scene script from Field Station with production tags, written by
     hand in the shape Method Schedule reads (E-I5, IMP-04): a prop, a cast member and a
     vehicle tagged, plus a set dressing item. Not from any real production. -->
<Content>
<Paragraph Type="Scene Heading" Number="1"><SceneProperties Length="4/8" Page="1"/><Text>INT. FIELD STATION - RADIO ROOM - NIGHT</Text></Paragraph>
<Paragraph Type="Action"><Text TagNumber="1">Mara</Text><Text> keys the </Text><Text TagNumber="2">hand radio</Text><Text>. Static. Rain on the </Text><Text TagNumber="5">fuel drums</Text><Text> outside.</Text></Paragraph>
<Paragraph Type="Character"><Text>MARA</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Ridge base, this is the station. Do you read?</Text></Paragraph>
<Paragraph Type="Scene Heading" Number="2"><SceneProperties Length="6/8" Page="1"/><Text>EXT. RIDGE ROAD - NIGHT</Text></Paragraph>
<Paragraph Type="Action"><Text>The </Text><Text TagNumber="3">park truck</Text><Text> grinds uphill, wipers losing. </Text><Text TagNumber="4">Teo</Text><Text> holds the wheel with both hands.</Text></Paragraph>
<Paragraph Type="Character"><Text>TEO</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Ten more minutes. Tell her ten.</Text></Paragraph>
<Paragraph Type="Scene Heading" Number="3"><SceneProperties Length="2/8" Page="2"/><Text>INT. FIELD STATION - RADIO ROOM - NIGHT</Text></Paragraph>
<Paragraph Type="Action"><Text TagNumber="1">Mara</Text><Text> sets the </Text><Text TagNumber="2">radio</Text><Text> down and waits.</Text></Paragraph>
</Content>
